<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
        <RootNamespace>Pathetic.App</RootNamespace>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <RuntimeIdentifier>$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
        <SelfContained>false</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Pathetic.Renderer\Pathetic.Renderer.csproj" />
        <ProjectReference Include="..\Pathetic.Scene\Pathetic.Scene.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
        <PackageReference Include="NeoVeldrid" Version="1.2.1" />
        <PackageReference Include="NeoVeldrid.ImageSharp" Version="1.2.1" />
        <PackageReference Include="NeoVeldrid.ImGui" Version="1.2.1" />
        <PackageReference Include="NeoVeldrid.SPIRV" Version="1.2.1" />
        <PackageReference Include="NeoVeldrid.StartupUtilities" Version="1.2.1" />
        <PackageReference Include="Prowl.Slang" Version="3.3.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Shaders/**/*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
