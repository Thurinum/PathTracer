<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
        <RootNamespace>PathTracerApp</RootNamespace>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <PropertyGroup>
        <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.26425.128" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0-rc.1.26425.128" />
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
      <PackageReference Include="NeoVeldrid" Version="1.2.1" />
      <PackageReference Include="NeoVeldrid.ImageSharp" Version="1.2.1" />
      <PackageReference Include="NeoVeldrid.ImGui" Version="1.2.1" />
      <PackageReference Include="NeoVeldrid.SPIRV" Version="1.2.1" />
      <PackageReference Include="NeoVeldrid.StartupUtilities" Version="1.2.1" />
      <PackageReference Include="Prowl.Slang" Version="3.3.0" />
      <PackageReference Include="Silk.NET.Shaderc" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Shaderc.Native" Version="2.23.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Resources/**/*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
